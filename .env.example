# Optional: used only to phrase grounded results. The reasoning engine
# runs fully without an LLM and never invents unsourced claims.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Fetch climate normals from Open-Meteo when coordinates are provided.
ENABLE_GEO_CLIMATE=true
